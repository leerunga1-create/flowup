using Microsoft.AspNetCore.Mvc;
using Oracle.ManagedDataAccess.Client;
using System;
using System.Collections.Generic;

namespace FlowUpApi.Controllers
{
    // 데이터 수신용 DTO
    public class VisitorDataDto
    {
        public int StoreId { get; set; }        // 매장 ID (기본값: 1)
        public int InCount { get; set; }        // 입장 인원
        public int OutCount { get; set; }       // 퇴장 인원
        public int CurrentPeople { get; set; }  // 현재 체류 인원
    }

    [ApiController]
    [Route("api/[controller]")]
    public class SensorController : ControllerBase
    {
        // ⚠️ 오라클 비밀번호(YOUR_PASSWORD) 수정 필수
        private readonly string _oracleConnStr = "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=xe)));User Id=system;Password=1234;";

        // 1. [POST] 아두이노 -> 오라클 DB 데이터 저장 API
        // 주소: http://localhost:5013/api/sensor/visitor
        [HttpPost("visitor")]
        public IActionResult ReceiveVisitorData([FromBody] VisitorDataDto dto)
        {
            if (dto == null) return BadRequest(new { status = "Error", message = "데이터가 비어있습니다." });

            try
            {
                using (OracleConnection conn = new OracleConnection(_oracleConnStr))
                {
                    conn.Open();

                    string query = @"INSERT INTO VISITOR_LOGS 
                                    (LOG_ID, STORE_ID, IN_COUNT, OUT_COUNT, CURRENT_PEOPLE, LOG_TIME) 
                                    VALUES 
                                    (VISITOR_LOGS_SEQ.NEXTVAL, :storeId, :inCount, :outCount, :currentPeople, SYSTIMESTAMP)";

                    using (OracleCommand cmd = new OracleCommand(query, conn))
                    {
                        cmd.Parameters.Add(new OracleParameter("storeId", dto.StoreId));
                        cmd.Parameters.Add(new OracleParameter("inCount", dto.InCount));
                        cmd.Parameters.Add(new OracleParameter("outCount", dto.OutCount));
                        cmd.Parameters.Add(new OracleParameter("currentPeople", dto.CurrentPeople));

                        cmd.ExecuteNonQuery();
                    }
                }
                return Ok(new { status = "Success", message = "오라클 DB 저장 완료" });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { status = "Error", message = ex.Message });
            }
        }

        // 2. [GET] DB -> 웹 대시보드 데이터 조회 API (404 오류 해결용)
        // 주소: http://localhost:5013/api/sensor/current/1
        [HttpGet("current/{storeId}")]
        public IActionResult GetCurrentStatus(int storeId)
        {
            try
            {
                using (OracleConnection conn = new OracleConnection(_oracleConnStr))
                {
                    conn.Open();

                    // 매장 정보 및 오늘 누적 인원 조회 Query
                    string summaryQuery = @"
                        SELECT 
                            S.STORE_NAME,
                            NVL((SELECT SUM(IN_COUNT) FROM VISITOR_LOGS WHERE STORE_ID = :storeId AND TRUNC(LOG_TIME) = TRUNC(SYSDATE)), 0) AS TODAY_IN,
                            NVL((SELECT SUM(OUT_COUNT) FROM VISITOR_LOGS WHERE STORE_ID = :storeId AND TRUNC(LOG_TIME) = TRUNC(SYSDATE)), 0) AS TODAY_OUT,
                            NVL((SELECT CURRENT_PEOPLE FROM (SELECT CURRENT_PEOPLE FROM VISITOR_LOGS WHERE STORE_ID = :storeId ORDER BY LOG_ID DESC) WHERE ROWNUM = 1), 0) AS CURRENT_PEOPLE
                        FROM STORES S
                        WHERE S.STORE_ID = :storeId";

                    string storeName = "알 수 없음";
                    int todayIn = 0, todayOut = 0, currentPeople = 0;

                    using (OracleCommand cmd = new OracleCommand(summaryQuery, conn))
                    {
                        cmd.Parameters.Add(new OracleParameter("storeId", storeId));
                        using (var reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                storeName = reader["STORE_NAME"].ToString();
                                todayIn = Convert.ToInt32(reader["TODAY_IN"]);
                                todayOut = Convert.ToInt32(reader["TODAY_OUT"]);
                                currentPeople = Convert.ToInt32(reader["CURRENT_PEOPLE"]);
                            }
                        }
                    }

                    // 최근 5개 로그 조회 Query
                    string logQuery = @"
                        SELECT LOG_ID, IN_COUNT, OUT_COUNT, CURRENT_PEOPLE, TO_CHAR(LOG_TIME, 'YYYY-MM-DD HH24:MI:SS') AS LOG_TIME
                        FROM (SELECT LOG_ID, IN_COUNT, OUT_COUNT, CURRENT_PEOPLE, LOG_TIME FROM VISITOR_LOGS WHERE STORE_ID = :storeId ORDER BY LOG_ID DESC)
                        WHERE ROWNUM <= 5";

                    var logs = new List<object>();
                    using (OracleCommand cmd = new OracleCommand(logQuery, conn))
                    {
                        cmd.Parameters.Add(new OracleParameter("storeId", storeId));
                        using (var reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                logs.Add(new {
                                    logId = reader["LOG_ID"],
                                    inCount = reader["IN_COUNT"],
                                    outCount = reader["OUT_COUNT"],
                                    currentPeople = reader["CURRENT_PEOPLE"],
                                    logTime = reader["LOG_TIME"].ToString()
                                });
                            }
                        }
                    }

                    return Ok(new { storeId, storeName, todayIn, todayOut, currentPeople, recentLogs = logs });
                }
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { status = "Error", message = "DB 연동 오류: " + ex.Message });
            }
        }
    }
}